<div class="field">
  <label for="<%= prefix %>-title">Название <span class="req">*</span></label>
  <input id="<%= prefix %>-title" name="title" type="text" maxlength="200" required
         placeholder="Например: подготовить отчёт по лабораторной" value="<%= form.title %>">
  <% if (errors.title) { %><p class="field__error"><%= errors.title %></p><% } %>
</div>

<div class="field">
  <label for="<%= prefix %>-description">Описание</label>
  <textarea id="<%= prefix %>-description" name="description" rows="3" maxlength="2000"
            placeholder="Детали, ссылки, критерии готовности"><%= form.description %></textarea>
  <% if (errors.description) { %><p class="field__error"><%= errors.description %></p><% } %>
</div>

<div class="field-row">
  <div class="field">
    <label for="<%= prefix %>-status">Статус</label>
    <select id="<%= prefix %>-status" name="status">
      <% STATUSES.forEach((status) => { %>
        <option value="<%= status.value %>" <%= form.status === status.value ? 'selected' : '' %>><%= status.label %></option>
      <% }); %>
    </select>
    <% if (errors.status) { %><p class="field__error"><%= errors.status %></p><% } %>
  </div>

  <div class="field">
    <label for="<%= prefix %>-dueDate">Ожидаемая дата завершения</label>
    <input id="<%= prefix %>-dueDate" name="dueDate" type="date" value="<%= form.dueDate %>">
    <% if (errors.dueDate) { %><p class="field__error"><%= errors.dueDate %></p><% } %>
  </div>

  <div class="field">
    <label for="<%= prefix %>-attachments">Вложения</label>
    <input id="<%= prefix %>-attachments" name="attachments" type="file" multiple>
    <p class="field__hint">До <%= maxFiles %> файлов, каждый до <%= formatSize(maxFileSize) %></p>
  </div>
</div>
