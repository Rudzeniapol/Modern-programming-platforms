# Скопируйте в .env, чтобы переопределить значения по умолчанию.
APP_PORT=8092
POSTGRES_DB=pixels
POSTGRES_USER=pixels
POSTGRES_PASSWORD=pixels

# Игровые параметры
ROUND_DURATION_SEC=600
CHARGES_MAX=10
CHARGE_REGEN_MS=3000
LOG_LEVEL=info

# Для облачного Postgres (Neon, Supabase…) — строка подключения и TLS:
# DATABASE_URL=postgres://user:password@host/db
# DATABASE_SSL=true
