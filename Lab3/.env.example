# Скопируйте в .env, чтобы переопределить значения по умолчанию.
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks

# Порт SPA (открывается в браузере)
WEB_PORT=8089
# Порт REST API для прямых запросов curl/Postman
API_PORT=3003
# Веб-интерфейс Mailpit (письма восстановления пароля)
MAIL_UI_PORT=8026
# Адрес SPA, на который ведут ссылки из писем
APP_URL=http://localhost:8089

# Ключ подписи access-токенов (сгенерировать: openssl rand -base64 48)
JWT_SECRET=change-me
# Время жизни временных ключей, секунды
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# Не больше N одновременных сессий на пользователя
MAX_SESSIONS_PER_USER=5
# Блокировка входа: после N неудач подряд — на LOCKOUT секунд
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_LOCKOUT_SEC=900

# Первый администратор (создаётся при первом запуске)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345

LOG_LEVEL=info
