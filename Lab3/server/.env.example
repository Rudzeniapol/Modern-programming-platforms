# Локальный запуск API без Docker (docker-compose задаёт эти значения сам)
PORT=3000
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
UPLOADS_DIR=./uploads
# Нужен только если клиент запускается на другом origin без прокси
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
MAX_SESSIONS_PER_USER=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_SEC=900

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345

# SMTP (например, Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Менеджер задач <no-reply@tasks.local>

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
